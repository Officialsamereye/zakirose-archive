#!/bin/bash
# Zaki Rose Archive — starts the rclone engine as a background service (if it isn't running) and opens the dashboard.
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
UI="$CONTENTS/Resources/ui"
SUP="$HOME/Library/Application Support/Zaki Rose Archive"
LABEL="com.zakirose.archive.engine"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PORT=5572
VERSION="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$CONTENTS/Info.plist" 2>/dev/null)"
mkdir -p "$SUP/logs" "$HOME/Library/LaunchAgents"

alert() { osascript -e "display alert \"Zaki Rose Archive\" message \"$1\" as critical" >/dev/null 2>&1; }

RCLONE=""
for c in /usr/local/bin/rclone /opt/homebrew/bin/rclone "$HOME/bin/rclone"; do [ -x "$c" ] && RCLONE="$c" && break; done
if [ -z "$RCLONE" ]; then alert "rclone isn't installed. Run the Zaki Rose Archive install line in Terminal again."; exit 1; fi

# private engine password, made once
if [ ! -s "$SUP/.engine" ]; then (umask 077; openssl rand -hex 16 > "$SUP/.engine"); fi
PASS="$(cat "$SUP/.engine")"
KEY="$(printf 'zr:%s' "$PASS" | base64)"

# tell the dashboard where its settings live
printf '{"supportDir":"%s","appVersion":"%s","rclone":"%s"}\n' "$SUP" "$VERSION" "$RCLONE" > "$UI/env.json"

running() { curl -s -f -m 2 -u "zr:$PASS" -X POST "http://127.0.0.1:$PORT/core/version" >/dev/null 2>&1; }

if ! running; then
  BW="$(plutil -extract bwlimit raw -o - "$SUP/settings.json" 2>/dev/null)"
  [ -z "$BW" ] && BW="00:00,off 23:59,off"
  # The engine runs as its own launchd service so macOS privacy permissions
  # (Full Disk Access) apply to rclone itself.
  ARGS=("$RCLONE" rcd
    --rc-addr "127.0.0.1:$PORT" --rc-user zr --rc-pass "$PASS"
    --rc-files "$UI" --rc-serve --rc-job-expire-duration 2h
    --bwlimit "$BW" --transfers 8 --checkers 16
    --dropbox-batch-mode sync --dropbox-chunk-size 64Mi
    --retries 5 --low-level-retries 20
    --log-file "$SUP/logs/engine.log" --log-level INFO)
  {
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    echo '<plist version="1.0"><dict>'
    echo "<key>Label</key><string>$LABEL</string>"
    echo '<key>ProgramArguments</key><array>'
    for a in "${ARGS[@]}"; do a="${a//&/&amp;}"; a="${a//</&lt;}"; echo "<string>$a</string>"; done
    echo '</array>'
    echo '<key>RunAtLoad</key><true/>'
    echo '<key>ProcessType</key><string>Background</string>'
    echo "<key>StandardErrorPath</key><string>$SUP/logs/engine-launch.log</string>"
    echo '</dict></plist>'
  } > "$PLIST"
  chmod 600 "$PLIST"
  launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1
  launchctl bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
  for i in $(seq 1 40); do running && break; sleep 0.25; done
  if ! running; then alert "The transfer engine didn't start. Details are in: $SUP/logs/engine.log"; exit 1; fi
fi

# keep the Mac awake (not the screen) while the engine runs
EPID="$(pgrep -f "rclone rcd --rc-addr 127.0.0.1:$PORT" | head -n 1)"
if [ -n "$EPID" ] && ! pgrep -f "caffeinate -i -w $EPID" >/dev/null; then nohup caffeinate -i -w "$EPID" >/dev/null 2>&1 & fi

URL="http://zr:$PASS@127.0.0.1:$PORT/#k=$KEY"
if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args --app="$URL" --window-size=1360,960
else
  open "$URL"
fi
